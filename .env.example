# ============================================================
# Voice AI Termux — ตั้งค่า LLM server
#
# วิธีใช้: คัดลอกไฟล์นี้ไปเป็น ".env" แล้วแก้ค่าตามเครื่องคุณ
#   cp .env.example .env
#   nano .env      ← ใส่ IP ของคุณ
#
# ใส่แค่ IP ก็พอ — ระบบจะหา model + สร้าง URL ให้อัตโนมัติ
# ============================================================

# --- วิธีที่ 1 (แนะนำ): ใส่แค่ IP + port แยกกัน ---
LLM_IP=192.168.x.x
LLM_PORT=8080

# --- วิธีที่ 2 (ทางเลือก): ใส่ URL เต็ม http://IP:port (port ตามใจ)
# --- ใช้วิธีนี้ถ้า port ไม่ใช่ 8080 หรืออยากระบุชัดเจน
# --- (ถ้าใส่ LLM_BASE จะใช้ตัวนี้แทน LLM_IP)
# LLM_BASE=http://192.168.x.x:11434

# --- (optional) ถ้า server มีหลาย model อยากเลือกเอง ใส่ชื่อ model
# --- (ถ้าข้าม ระบบจะค้นหา model แรกให้อัตโนมัติ)
# LLM_MODEL=/models/your-model.gguf

# --- (optional) context window (token)
# LLM_CTX=8192
